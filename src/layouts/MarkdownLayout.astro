---
import Layout from "./Layout.astro";
import Sidebar from "../components/Sidebar.astro";
import { getSnippetPages } from "../lib/snippets.ts";

interface ContentProps {
  title?: string;
}

interface Props {
  title?: string;
  currentID?: string;
  content?: ContentProps;
}

const { title, currentID, content } = Astro.props;
const frontmatter = content ?? {};
const resolvedTitle = title ?? frontmatter.title ?? "Snippets";
const pages = await getSnippetPages();
---

<Layout title={resolvedTitle}>
  <header class="mobile-header">
    <a class="mobile-site-name" href="/">Snippets</a>
    <button class="menu-btn" type="button" aria-label="Open navigation" aria-controls="sidebar">
      <svg
        width="1em"
        height="1em"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M4 5h16"></path>
        <path d="M4 12h16"></path>
        <path d="M4 19h16"></path>
      </svg>
    </button>
  </header>
  <div class="app">
    <Sidebar pages={pages} currentID={currentID} />
    <main class="main">
      <div class="md">
        <slot />
      </div>
    </main>
  </div>
</Layout>

<script>
  import { queryElement } from "../lib/dom";

  const consolePattern = /^(\$ )/gm;
  function handleCopyCode(button: Element) {
    const codeBlock = button.closest(".code-wrapper")?.querySelector("pre");
    if (!codeBlock) return;
    if (!(codeBlock instanceof HTMLElement)) return;

    const codeElement = codeBlock.querySelector("code");
    if (!codeElement) return;

    // Console snippets usually start with '$ ' to get correct highlighting. This will try and
    // remove that so that the copy button copies a command that can be directly pasted into
    // a terminal.
    const text =
      codeBlock.dataset.language === "console"
        ? codeElement.textContent.replaceAll(consolePattern, "")
        : codeElement.textContent;

    navigator.clipboard
      .writeText(text)
      .catch((err) => {
        console.error("Failed to copy: ", err);
      });
  }

  document.querySelectorAll(".copy-code-btn").forEach((button) => {
    button.addEventListener("click", () => {
      handleCopyCode(button);
      button.classList.add("copied");
      setTimeout(() => button.classList.remove("copied"), 1800);
    });
  });

  document.querySelectorAll(".code-wrapper").forEach((wrapper) => {
    if (!(wrapper instanceof HTMLElement)) return;
    const pre = wrapper.querySelector("pre");
    if (!pre) return;
    wrapper.classList.toggle("has-overflow", pre.scrollWidth > pre.clientWidth);
    const sync = () => wrapper.classList.toggle("is-scrolled", pre.scrollLeft > 1);
    pre.addEventListener("scroll", sync);
    sync();
  });

  const app = queryElement(document, ".app", HTMLElement);
  const menuButton = queryElement(document, ".menu-btn", HTMLButtonElement);
  if (app instanceof HTMLElement && menuButton instanceof HTMLElement) {
    function setDrawerOpen(open: boolean) {
      app.classList.toggle("is-open", open);
      menuButton.setAttribute("aria-expanded", String(open));
    }

    menuButton.addEventListener("click", () => {
      setDrawerOpen(!app.classList.contains("is-open"));
    });

    document.querySelectorAll(".tree-link").forEach((link) => {
      link.addEventListener("click", () => {
        setDrawerOpen(false);
      });
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        setDrawerOpen(false);
      }
    });
  }
</script>
