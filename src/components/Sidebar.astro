---
import { type SnippetPages, getSnippetURL } from "../lib/snippets.ts";

interface Props {
  pages: SnippetPages;
  currentID?: string;
}

const { pages, currentID } = Astro.props;

function toTitleCase(str: string): string {
  return str.replace(/\w\S*/g, (text) => text.charAt(0).toUpperCase() + text.substring(1).toLowerCase());
}

function formatCategoryTitle(category: string): string {
  if (category === "cpp") return "C++";
  return toTitleCase(category);
}
---

<aside class="sidebar" id="sidebar">
  <a class="site-name" href="/">Snippets</a>
  <div class="sidebar-search">
    <input id="sidebar-search" type="text" placeholder="Search snippets..." autocomplete="off" spellcheck="false" />
    <kbd>/</kbd>
  </div>
  <nav class="tree">
    {
      [...pages.entries()].map(([category, snippets]) => {
        const isOpen = snippets.some((snippet) => snippet.id === currentID);
        return (
          <section class:list={["tree-section", { open: isOpen }]} data-category={category}>
            <button class="tree-parent" type="button" aria-expanded={isOpen}>
              <svg
                class="tree-chevron"
                width="1em"
                height="1em"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M3 8L12 17L21 8" />
              </svg>
              <span>{formatCategoryTitle(category)}</span>
            </button>
            <ul class="tree-children">
              {snippets.map((snippet) => (
                <li>
                  <a
                    class:list={["tree-link", { active: snippet.id === currentID }]}
                    data-name={snippet.data.title.toLowerCase()}
                    href={getSnippetURL(snippet.id)}
                  >
                    {snippet.data.title}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        );
      })
    }
  </nav>
  <p class="no-results" hidden>No snippets match your search.</p>
</aside>

<script is:inline>
  (() => {
    try {
      const stored = JSON.parse(sessionStorage.getItem("snippets-sidebar-state") || "{}");
      if (!stored || typeof stored !== "object") return;
      document.querySelectorAll(".tree-section").forEach((section) => {
        const category = section.dataset.category;
        if (!category || typeof stored[category] !== "boolean") return;
        const open = stored[category];
        section.classList.toggle("open", open);
        const button = section.querySelector(".tree-parent");
        if (button) button.setAttribute("aria-expanded", String(open));
      });
    } catch {}
  })();
</script>

<script>
  const STORAGE_KEY = "snippets-sidebar-state";

  type SidebarState = Record<string, boolean>;

  function readState(): SidebarState {
    try {
      const raw = sessionStorage.getItem(STORAGE_KEY);
      const state = JSON.parse(raw || "{}") as unknown;
      return state && typeof state === "object" ? (state as SidebarState) : {};
    } catch {
      return {};
    }
  }

  function writeState(state: SidebarState) {
    try {
      sessionStorage.setItem(STORAGE_KEY, JSON.stringify(state));
    } catch {}
  }

  for (const button of document.querySelectorAll<HTMLButtonElement>(".tree-parent")) {
    button.addEventListener("click", () => {
      const section = button.closest(".tree-section");
      if (!section) return;
      const isOpen = section.classList.toggle("open");
      button.setAttribute("aria-expanded", String(isOpen));
      const category = section.dataset.category;
      if (!category) return;
      const nextState = readState();
      nextState[category] = isOpen;
      writeState(nextState);
    });
  }

  const sidebar = document.querySelector(".sidebar");
  const search = document.querySelector<HTMLInputElement>("#sidebar-search");
  const noResults = document.querySelector<HTMLElement>(".no-results");

  function updateSearch(query: string) {
    let anyMatches = false;
    for (const section of document.querySelectorAll<HTMLElement>(".tree-section")) {
      let hasMatch = false;
      for (const link of section.querySelectorAll<HTMLElement>(".tree-link")) {
        const name = link.dataset.name || "";
        const category = section.dataset.category || "";
        const match = !query || name.includes(query) || category.includes(query);
        link.classList.toggle("is-hidden", !match);
        if (match) hasMatch = true;
      }
      section.classList.toggle("has-matches", hasMatch);
      if (hasMatch) anyMatches = true;
    }
    sidebar?.classList.toggle("searching", query !== "");
    if (noResults) noResults.hidden = query === "" || anyMatches;
  }

  search?.addEventListener("input", () => {
    updateSearch(search.value.trim().toLowerCase());
  });

  search?.addEventListener("keydown", (e) => {
    if (e.key === "Escape") {
      e.stopPropagation();
      search.value = "";
      updateSearch("");
      search.blur();
    }
  });

  const INPUT_TAGS = new Set(["input", "textarea", "select"]);
  document.addEventListener("keydown", (e) => {
    if (e.key !== "/" || e.ctrlKey || e.metaKey) return;
    if (e.target instanceof HTMLElement && INPUT_TAGS.has(e.target.tagName.toLowerCase())) return;

    e.preventDefault();
    search?.focus();
  });
</script>
