---
import { type SnippetPages, getSnippetURL } from "../lib/snippets.ts";
import HomeIcon from "./HomeIcon.astro";

interface Props {
  pages: SnippetPages;
  currentID?: string;
}

const { pages, currentID } = Astro.props;

function toTitleCase(str: string): string {
  return str.replace(/\w\S*/g, (text) => text.charAt(0).toUpperCase() + text.substring(1).toLowerCase());
}

function formatCategoryTitle(category: string): string {
  if (category === "cpp") return "C++";
  return toTitleCase(category);
}
---

<aside class="sidebar" id="sidebar">
  <div class="sidebar-header">
    <a class="sidebar-home" href="/" aria-label="Home">
      <HomeIcon />
    </a>
    <div class="sidebar-search">
      <input id="sidebar-search" type="text" placeholder="Search..." autocomplete="off" spellcheck="false" />
      <kbd>/</kbd>
    </div>
  </div>
  <nav class="sidebar-tree">
    {[...pages.entries()].map(([category, snippets]) => {
      return (
        <section class="sidebar-section" data-category={category}>
          <h2 class="sidebar-parent">{formatCategoryTitle(category)}</h2>
          <ul class="sidebar-children">
            {snippets.map((snippet) => (
              <li>
                <a
                  class:list={["sidebar-link", { active: snippet.id === currentID }]}
                  data-name={snippet.data.title.toLowerCase()}
                  href={getSnippetURL(snippet.id)}
                >
                  {snippet.data.title}
                </a>
              </li>
            ))}
          </ul>
        </section>
      );
    })}
  </nav>
  <p class="no-results" hidden>
    No snippets match your search.
  </p>
</aside>

<script>
  const sidebar = document.querySelector(".sidebar");
  const search = document.querySelector<HTMLInputElement>("#sidebar-search");
  const noResults = document.querySelector<HTMLElement>(".no-results");

  function updateSearch(query: string) {
    let anyMatches = false;
    for (const section of document.querySelectorAll<HTMLElement>(".sidebar-section")) {
      let hasMatch = false;
      for (const link of section.querySelectorAll<HTMLElement>(".sidebar-link")) {
        const name = link.dataset.name || "";
        const category = section.dataset.category || "";
        const match = !query || name.includes(query) || category.includes(query);
        link.classList.toggle("is-hidden", !match);
        if (match) hasMatch = true;
      }
      section.classList.toggle("has-matches", hasMatch);
      if (hasMatch) anyMatches = true;
    }
    sidebar?.classList.toggle("searching", query !== "");
    if (noResults) noResults.hidden = query === "" || anyMatches;
  }

  search?.addEventListener("input", () => {
    updateSearch(search.value.trim().toLowerCase());
  });

  search?.addEventListener("keydown", (e) => {
    if (e.key === "Escape") {
      e.stopPropagation();
      search.value = "";
      updateSearch("");
      search.blur();
    }
  });

  const INPUT_TAGS = new Set(["input", "textarea", "select"]);
  document.addEventListener("keydown", (e) => {
    if (e.key !== "/" || e.ctrlKey || e.metaKey) return;
    if (e.target instanceof HTMLElement && INPUT_TAGS.has(e.target.tagName.toLowerCase())) return;

    e.preventDefault();
    search?.focus();
  });
</script>
